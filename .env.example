# PO Dashboard Environment Variables
# Copy this file to .env and fill in your values

# n8n Webhook URLs
VITE_WEBHOOK_URL=http://your-n8n-server:5678/webhook/po-process
VITE_GRN_WEBHOOK_URL=http://your-n8n-server:5678/webhook/grn-process

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
